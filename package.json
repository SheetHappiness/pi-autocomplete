{
  "name": "pi-autocomplete",
  "version": "0.1.2",
  "description": "Local, private ghost-text word autocomplete for Pi with a personal dictionary and SmolLM2 fallback",
  "repository": {
    "type": "git",
    "url": "https://github.com/softsock/pi-autocomplete.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "autocomplete",
    "ghost-text",
    "local-llm",
    "smollm2",
    "offline-inference",
    "word-completion"
  ],
  "pi": {
    "extensions": [
      "./src/pi-autocomplete.ts"
    ]
  },
  "files": [
    "src",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "vendor/omp/PROVENANCE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.*",
    "check": "tsc --noEmit",
    "release:check": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0 <1.8.0",
    "@earendil-works/pi-tui": ">=1.3.0 <1.8.0"
  },
  "optionalDependencies": {
    "@sheethappiness/pi-ghost-autocomplete-darwin-arm64": "0.1.2",
    "@sheethappiness/pi-ghost-autocomplete-linux-arm64-gnu": "0.1.2",
    "@sheethappiness/pi-ghost-autocomplete-linux-x64-gnu": "0.1.2",
    "@sheethappiness/pi-ghost-autocomplete-win32-x64-msvc": "0.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "22.19.19",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/softsock/pi-autocomplete#readme",
  "bugs": {
    "url": "https://github.com/softsock/pi-autocomplete/issues"
  }
}
